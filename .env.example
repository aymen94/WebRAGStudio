# Local Ollama (no API key required)
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-r1:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# Retrieval settings (optional; editable in the Settings page)
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0

# Optional. If unset, the app creates a local encryption key in data/settings.key.
# Keep this value stable if you configure it, or saved provider keys cannot be decrypted.
# SETTINGS_ENCRYPTION_KEY=

# OpenAI hosted API example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-openai-api-key

# Other OpenAI-compatible servers (vLLM, LM Studio, etc.):
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-chat-model
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_BASE_URL=http://localhost:8000/v1
# EMBEDDING_API_KEY=
